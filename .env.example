# Öffentliche Build-Variablen (Vite) – Vorlage.
#
# Die Datei .env gehört NICHT ins Repository (.gitignore, Pre-Commit-Hook und `npm test` verhindern es).
# Für die lokale Entwicklung: diese Datei nach .env kopieren und die Werte eintragen.
# Für den Build beim Hoster (Coolify): die Variablen dort als Build-Variablen setzen.
#
# Alles mit dem Präfix VITE_ wird in das Frontend-Bundle eingebettet und ist für jeden Besucher lesbar.
# Deshalb gehören hierher ausschließlich öffentliche Werte. Niemals den service_role-Schlüssel,
# keinen Supabase Secret Key (sb_secret_...), keine Stripe-, Resend- oder sonstigen Server-Schlüssel eintragen.

# Freiwillig: Ohne Angabe gilt die Vorgabe aus vite.config.ts (das Supabase-Projekt dieser Website).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Pflicht: der öffentliche Schlüssel des Projekts (Publishable Key, sb_publishable_...).
VITE_SUPABASE_PUBLISHABLE_KEY=<öffentlicher Schlüssel>
# Freiwillig: Ohne Angabe gelten die Vorgaben aus src/lib/url.ts.
VITE_PUBLIC_SITE_URL=https://digital-perfect.com
VITE_INTERNAL_RENDER_HOSTS=prerender.digital-perfect.com,localhost,127.0.0.1

# Privilegierte Schlüssel gehören ausschließlich hierhin:
#  - Edge Functions: Supabase stellt SUPABASE_SECRET_KEYS selbst bereit.
#    Eigene Geheimnisse (Stripe, Resend, Webhook-Kennwörter): supabase secrets set NAME=Wert
#  - Server-Prozesse (Prerender-Dienst, Cloudflare Worker): Umgebung des Hosters bzw. Worker-Secrets,
#    Vorlagen siehe prerender-service/.env.example und cloudflare-worker/.dev.vars.example.
